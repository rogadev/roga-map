# Mapbox Configuration
# Get your access token from https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Nuxt Configuration
# Set to 'production' for production builds
NODE_ENV=development

# Server Configuration
NUXT_HOST=localhost
NUXT_PORT=3000

# Optional: Base URL for your app (useful for deployment)
NUXT_APP_BASE_URL=http://localhost:3000

# Optional: Secret key for session management (generate a random string)
NUXT_SECRET_KEY=your_secret_key_here

# Optional: Database URL (if you add database functionality later)
# DATABASE_URL=your_database_connection_string_here

# Optional: API Base URL (if you connect to external APIs)
# API_BASE_URL=https://api.example.com
